<section class="srt">
  <header class="srt-head">
    <div class="srt-badge">SKY REGATTA</div>
    <div class="srt-lap">{{lapLabel}}</div>
    <div class="srt-sub">{{subtitle}}</div>
  </header>

  <ol class="srt-rows">
    <li class="srt-row srt-cols-head">
      <span class="pos"></span><span class="tag"></span><span class="name"></span>
      <span class="delta">THIS</span><span class="total">VP</span><span class="movegap"><span class="move"></span><span class="gap">GAP</span></span>
    </li>
    {{#each rows}}
    <li class="srt-row {{#if isLeader}}leader{{/if}} {{#if pc}}pc{{/if}} {{rowClass}}" data-id="{{id}}">
      <span class="pos">{{rank}}</span>
      <span class="tag" style="--team: {{color}}">{{code}}</span>
      <span class="name">
        {{#if portrait}}<img class="portrait" src="{{portrait}}" alt="">{{/if}}
        {{name}}
      </span>
      <span class="delta {{deltaClass}}">{{deltaText}}</span>
      <span class="total">{{total}}</span>
      <span class="movegap">
        <span class="move {{moveClass}}">{{moveText}}</span>
        <span class="gap {{#if isLeader}}lead{{/if}}">{{gapText}}</span>
      </span>
    </li>
    {{/each}}
  </ol>

  {{#if showStatus}}
  <div class="srt-status">
    <div class="srt-status-title">Skills used this lap</div>
    {{#each riders}}
    <div class="srt-used">
      <span class="who">{{name}}</span>
      <span class="drake {{drakeClass}}">Drake: {{drake}}</span>
      {{#if pit}}<span class="srt-pit">boxing</span>{{/if}}{{#if benchHelp}}<span class="srt-pit">bench {{benchHelp}}</span>{{/if}}
      <span class="chips">
        {{#if noneUsed}}<span class="none">nothing used yet</span>{{else}}{{#each used}}<span class="chip"><s>{{this}}</s></span>{{/each}}{{/if}}
      </span>
      {{#if rolled}}<span class="rolled-badge {{rolledClass}}">{{rolledLabel}}</span>{{/if}}
    </div>
    {{/each}}
    <div class="srt-line">Party Favor <b>{{status.favor}}</b> <i>({{status.favorSpent}}/2 spent this lap)</i></div>
    {{#if benchActs.length}}
    <div class="srt-bench-status">
      {{#each benchActs}}<div class="act"><span class="who">{{who}}</span> {{text}} <span class="rolled-badge {{degreeClass}}">{{degree}}</span> <i>{{notes}}</i></div>{{/each}}
    </div>
    {{/if}}
    {{#if canRoll}}<button type="button" class="srt-rollcheck" data-action="rollCheck"><i class="fa-solid fa-dice-d20"></i> Roll my check</button>{{/if}}
    {{#if canBench}}<button type="button" class="srt-rollcheck srt-benchbtn" data-action="benchAct"><i class="fa-solid fa-people-group"></i> Bench action</button>{{/if}}
  </div>
  {{/if}}

  {{#if isGM}}
  <footer class="srt-controls">
    <div class="srt-next">Next: <b>{{nextLabel}}</b></div>
    {{#unless finished}}
    <div class="srt-pcs">
      {{#each pcs}}
      <div class="srt-field srt-pc" data-pc="{{id}}">
        <span class="srt-label">{{name}} <i>(now {{base}} VP)</i></span>
        <span class="srt-pcrow">
          <span class="srt-step">
            <button type="button" class="srt-step-btn" data-action="step" data-dir="-1" data-for="gain_{{id}}" tabindex="-1">-</button>
            <input type="number" name="gain_{{id}}" value="{{gain}}" data-id="{{id}}" data-base="{{base}}" data-min="{{min}}" data-max="{{max}}" min="{{min}}" max="{{max}}" data-kind="pc">
            <button type="button" class="srt-step-btn" data-action="step" data-dir="1" data-for="gain_{{id}}" tabindex="-1">+</button>
          </span>
          <span class="srt-equals">adding</span>
          <span class="srt-newtotal">= <b data-total-for="{{id}}">{{newTotal}}</b> VP</span>
        </span>
        <span class="srt-hint" data-hint-for="{{id}}">allowed {{min}} to {{max}} this section{{#if pit}} (includes the -1 VP pit stop){{/if}}</span>
        {{#if hasPending}}
        <span class="srt-rolled">{{rolledText}}
          {{#if showSuggest}}<button type="button" class="srt-link srt-use" data-action="useSuggested" data-for="gain_{{id}}" data-value="{{suggested}}">use {{suggestedText}}</button>{{/if}}
          <button type="button" class="srt-link" data-action="clearRoll" data-pc="{{id}}">clear roll</button></span>
        {{else}}
        <span class="srt-rolled none">hasn't rolled yet</span>
        {{/if}}
      </div>
      {{/each}}
    </div>
    {{#if showShelter}}
    <div class="srt-shelter">
      {{#each pcs}}
      <label><input type="checkbox" name="{{id}}Sheltered" {{#if sheltered}}checked{{/if}}> {{name}} sheltered (Narrows)</label>
      {{/each}}
    </div>
    {{/if}}
    <details class="srt-adj" {{#if adjOpen}}open{{/if}}>
      <summary>NPC adjustments (a PC's Bump or Distract lands here)</summary>
      <div class="srt-adj-grid">
        {{#each adjustable}}
        <div class="srt-field">
          <span class="srt-label">{{name}}</span>
          <span class="srt-step">
            <button type="button" class="srt-step-btn" data-action="step" data-dir="-1" data-for="adj_{{id}}" tabindex="-1">-</button>
            <input type="number" name="adj_{{id}}" value="{{value}}" data-base="0" data-min="{{min}}" data-max="{{max}}" min="{{min}}" max="{{max}}" data-kind="adj">
            <button type="button" class="srt-step-btn" data-action="step" data-dir="1" data-for="adj_{{id}}" tabindex="-1">+</button>
          </span>
        </div>
        {{/each}}
      </div>
    </details>
    <details class="srt-adj srt-tune">
      <summary>Drake and Favor (pit actions, rulings)</summary>
      <div class="srt-tune-grid">
        {{#each riders}}
        <div class="srt-tune-row"><span>{{name}}'s drake: <b>{{drake}}</b></span>
          <button type="button" class="srt-step-btn" data-action="drake" data-pc="{{id}}" data-dir="-1" title="Raise a rung">-</button>
          <button type="button" class="srt-step-btn" data-action="drake" data-pc="{{id}}" data-dir="1" title="Drop a rung">+</button></div>
        {{/each}}
        <div class="srt-tune-row"><span>Party Favor: <b>{{status.favor}}</b></span>
          <button type="button" class="srt-step-btn" data-action="favor" data-dir="-1">-</button>
          <button type="button" class="srt-step-btn" data-action="favor" data-dir="1">+</button></div>
      </div>
    </details>
    {{#if benchWaiting}}<div class="srt-bench-status">Bench not yet acted: {{benchWaiting}}</div>{{/if}}
    {{#if benchActs.length}}
    <div class="srt-bench-status">Bench actions: {{#each benchActs}}<span>{{who}} <button type="button" class="srt-link" data-action="clearBench" data-bench="{{id}}">clear</button></span> {{/each}}</div>
    {{/if}}
    <label class="srt-unlock"><input type="checkbox" name="unlock"> Unlock limits (allowed this section: {{limitText}})</label>
    {{/unless}}
    <div class="srt-buttons srt-two">
      <button type="button" class="srt-show" data-action="postDcs"><i class="fa-solid fa-comment-dots"></i> Post DCs to chat</button>
      <button type="button" class="srt-show" data-action="show"><i class="fa-solid fa-tv"></i> Show to players</button>
    </div>
    <div class="srt-buttons">
      {{#unless finished}}<button type="button" class="srt-go" data-action="roll"><i class="fa-solid fa-dice"></i> Roll next section</button>{{/unless}}
      <button type="button" data-action="undo"><i class="fa-solid fa-rotate-left"></i> Undo</button>
      <button type="button" data-action="reset"><i class="fa-solid fa-trash"></i> Reset</button>
    </div>
  </footer>
  {{/if}}
</section>
